# LLM / AI Vision (Kenari gateway, OpenAI-compatible)
# The app reads LLM_* and falls back to the KENARI_* vars used by the scripts.
LLM_BASE_URL=https://kenari.id/v1
LLM_API_KEY=
LLM_MODEL=gemini-3-1-flash-lite

# Supabase (server-only, never expose the service role key)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Personal Access Token — only for running migrations (Management API / Supabase CLI)
SUPABASE_ACCESS_TOKEN=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Random string; Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=
# Optional: shown on Tentang/Privasi/Ketentuan as the contact address
NEXT_PUBLIC_CONTACT_EMAIL=
# Optional: verification code from Google Search Console (HTML tag method)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Scan quotas / anti-abuse. Turnstile is fail-closed: without a secret every scan
# is rejected. TURNSTILE_BYPASS=1 skips the check ONLY when NODE_ENV != production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_BYPASS=
SCAN_PER_MIN_IP=5
SCAN_PER_DAY_GUEST=10
SCAN_PER_DAY_USER=25
SCAN_PER_DAY_GLOBAL=200

# Test scripts (scripts/ocr-test.mjs)
GLM_BASE_URL=https://api.z.ai/api/paas/v4
GLM_API_KEY=
GLM_MODEL=glm-4.6v

MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M3

KENARI_BASE_URL=https://kenari.id/v1
KENARI_API_KEY=
KENARI_MODEL=gemini-3-1-flash-lite
