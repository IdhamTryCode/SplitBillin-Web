# LLM / AI Vision (Kenari gateway, OpenAI-compatible)
# The app reads LLM_* and falls back to the KENARI_* vars used by the scripts.
LLM_BASE_URL=https://kenari.id/v1
LLM_API_KEY=
LLM_MODEL=gemini-3-1-flash-lite

# Supabase (server-only, never expose the service role key)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=

# Scan quotas / anti-abuse (used from Step 5 onward)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_BYPASS=
SCAN_PER_MIN_IP=5
SCAN_PER_DAY_GUEST=10
SCAN_PER_DAY_USER=25
SCAN_PER_DAY_GLOBAL=200

# Test scripts (scripts/ocr-test.mjs)
GLM_BASE_URL=https://api.z.ai/api/paas/v4
GLM_API_KEY=
GLM_MODEL=glm-4.6v

MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M3

KENARI_BASE_URL=https://kenari.id/v1
KENARI_API_KEY=
KENARI_MODEL=gemini-3-1-flash-lite
